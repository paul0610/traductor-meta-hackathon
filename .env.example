# Copy to .env (never commit .env). Values below are defaults.

# Meta Model API key (dev.meta.ai). Required for ASR and Spark.
MODEL_API_KEY=

# Outgoing English voice. pocket runs on this PC; edge is the network voice.
RTT_TTS_ENGINE=pocket

# edge takes a clause the local voice fails or holds too long; none turns that off
RTT_TTS_BACKUP=edge

# Pocket TTS model and voice. Avoid voices from the ears and expresso sets: non-commercial.
RTT_POCKET_MODEL=english
RTT_POCKET_VOICE=michael

# Gain on the local voice, in dB. A clause that would clip rises less.
RTT_POCKET_GAIN_DB=3

# Edge TTS voice
RTT_TTS_VOICE=en-US-GuyNeural

# Substring of the VB-CABLE playback endpoint the TTS is written to
RTT_CABLE_NAME=CABLE Input

# Substring of the physical microphone (Realtek array on this PC)
RTT_MIC_NAME=Realtek

# Synchronized dub (piece 10): the other side gets my video and voice D seconds late, with the English voice on the
# lips. 1 needs OBS Studio installed once for its virtual camera driver, and "OBS Virtual Camera" picked in the call.
RTT_DUB=0

# D in seconds, fixed for the session
RTT_DELAY_S=6.0

# Original voice under the English while dubbing, in dB; -inf keeps it off the cable
RTT_VOICE_UNDER_DB=-20

# Substring of the webcam the dub delays, by name: this PC also has an IR camera
RTT_CAMERA_NAME=HD UVC

# Fixed A/V offset of cable + virtual camera, measured with the clap calibration
RTT_AV_OFFSET_MS=0

# incremental: clause by clause. consecutive: whole turns, the reliable fallback.
RTT_MODE=incremental

# 1 keeps the subtitle overlay out of screen shares and recordings. 0 is needed to record the demo.
RTT_OVERLAY_HIDE_FROM_CAPTURE=0
