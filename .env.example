# Copy to .env (never commit .env). Values below are defaults.

# Meta Model API key, from https://dev.meta.ai (free credits for hackathon participants). Required for ASR and Spark.
MODEL_API_KEY=

# Outgoing English voice: Meta's MMS-TTS on this PC.
RTT_TTS_ENGINE=mms
RTT_MMS_MODEL=facebook/mms-tts-eng

# Its pace. Lower is calmer, and then the English outlasts the Spanish it translates.
RTT_MMS_SPEAKING_RATE=1.45

# Terms Spark must render one way, and names the ASR should expect. See glossary.example.txt
RTT_GLOSSARY=glossary.txt

# Substring of the VB-CABLE playback endpoint the TTS is written to
RTT_CABLE_NAME=CABLE Input

# Substring of the physical microphone, such as Realtek. Empty uses the Windows default.
RTT_MIC_NAME=

# Synchronized dub (piece 10): the other side gets my video and voice D seconds late, with the English voice on the
# lips. 1 needs OBS Studio installed once for its virtual camera driver, and "OBS Virtual Camera" picked in the call.
RTT_DUB=0

# D in seconds, fixed for the session
RTT_DELAY_S=7.0

# Original voice under the English while dubbing, in dB; -inf keeps it off the cable
RTT_VOICE_UNDER_DB=-20

# Substring of the webcam the dub delays, by name, because a laptop may also have an IR camera. Change it to yours.
RTT_CAMERA_NAME=HD UVC

# Fixed A/V offset of cable + virtual camera, measured with the clap calibration
RTT_AV_OFFSET_MS=0

# incremental: clause by clause. consecutive: whole turns, the reliable fallback.
RTT_MODE=incremental

# Short sounds on your own headphones when the button changes state. The other side never hears them. 0 turns them off.
RTT_SOUNDS=1

# 1 keeps the subtitle overlay out of screen shares and recordings. 0 is needed to record the demo.
RTT_OVERLAY_HIDE_FROM_CAPTURE=0

# Not part of this submission, which only runs Meta models: uv sync --extra pocket, then RTT_TTS_ENGINE=pocket.
# RTT_TTS_BACKUP=edge               Edge takes a clause Pocket fails or holds too long
# RTT_POCKET_MODEL=english          avoid voices from the ears and expresso sets: non-commercial
# RTT_POCKET_VOICE=michael          a clone made in the widget takes its place until you turn it off there
# RTT_POCKET_GAIN_DB=3              a clause that would clip rises less
# RTT_TTS_VOICE=en-US-GuyNeural     the Edge voice
